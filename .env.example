# ─────────────────────────────────────────────────────────────────────────────
# PLANTILLA de variables de entorno. Cópiala a `.env` y rellena los valores.
#   cp .env.example .env
#
# `.env.example` SÍ se versiona (documenta qué necesita el proyecto).
# `.env` NUNCA se versiona (contiene secretos reales).
# ─────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL (Data Warehouse) ─────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marketplace_dwh
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# ─── MinIO (Data Lake, compatible con S3) ────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# ─── APIs externas ───────────────────────────────────────────────────────────
FX_API_BASE_URL=
FX_API_KEY=
WEATHER_API_BASE_URL=
WEATHER_API_KEY=

# ─── Entorno de ejecución ────────────────────────────────────────────────────
# local | dev | prod
ENVIRONMENT=local
LOG_LEVEL=INFO
