# ─────────────────────────────────────────────────────────────────────────────
# PLANTILLA de variables de entorno. Cópiala a `.env` y rellena los valores.
#   cp .env.example .env
#
# `.env.example` SÍ se versiona (documenta qué necesita el proyecto).
# `.env` NUNCA se versiona (contiene secretos reales).
# ─────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL (Data Warehouse) ─────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marketplace_dwh
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# ─── MinIO (Data Lake, compatible con S3) ────────────────────────────────────
# Data Lake: MinIO en local, S3 en AWS. El codigo habla la API de S3 en
# ambos casos, asi que migrar es cambiar estas variables, sin tocar Python.
#   LOCAL (MinIO):  S3_ENDPOINT=http://localhost:9000
#   AWS S3:         S3_ENDPOINT=            (vacio: lo resuelve la region)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=changeme
S3_SECRET_KEY=changeme

BUCKET_BRONZE=bronze
BUCKET_SILVER=silver
BUCKET_GOLD=gold

# MinIO en Docker sigue necesitando estas dos para arrancar el contenedor.
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme

# ─── APIs externas ───────────────────────────────────────────────────────────
FX_API_BASE_URL=
FX_API_KEY=
WEATHER_API_BASE_URL=
WEATHER_API_KEY=

# ─── Entorno de ejecución ────────────────────────────────────────────────────
# local | dev | prod
ENVIRONMENT=local
LOG_LEVEL=INFO
